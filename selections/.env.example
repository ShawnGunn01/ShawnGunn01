# Copy to .env (or set these in your host's environment settings).
PORT=3000

# Password your team uses to sign in as the builder. Required.
BUILDER_PASSWORD=change-me

# Where "Send to builder" submissions go.
BUILDER_EMAIL=Treese@rawdevelopment.com

# Email delivery (optional). With SMTP set, submissions are emailed. Without it,
# submissions are still saved on the job and logged, and the builder sees them
# in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Raw Development Selections <no-reply@rawdevelopment.com>"

# Optional: also POST each submission as JSON to this URL (Zapier, Make, Google Apps Script).
SUBMIT_WEBHOOK_URL=

# Where job records are stored (a JSON file). Point this at a persistent disk in production.
SELECTIONS_DATA_DIR=./data

# Public URL of the app, used to build client share links in emails.
PUBLIC_URL=http://localhost:3000
